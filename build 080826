/// Bollinger band
groupBB = "BOLLINGER BAND"
// Inputs
length0   = input.int(20, minval=1, group=groupBB)
maType0   = input.string("SMA", "Basis MA Type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group=groupBB)
src0      = input.source(close, title="Source", group=groupBB)
mult0     = input.float(2.0, minval=0.001, maxval=50, title="StdDev", group=groupBB)
OpenBolling = input.bool(false, title="Bật Bollinger Band", group=groupBB)   // Nút bật/tắt
Mausac      = input.color(color.rgb(33,150,243,95), "Màu nền", group=groupBB)
// MA function
ma(source, length, _type) =>
    _ma = switch _type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)
    _ma

// Bollinger Bands calculations
basis0 = ma(src0, length0, maType0)
dev0   = mult0 * ta.stdev(src0, length0)
upper0 = basis0 + dev0
lower0 = basis0 - dev0

// Offset
offset0 = input.int(0, "Offset", minval = -500, maxval = 500, group=groupBB)

// Plots (chỉ plot khi bật)
p_basis = plot(OpenBolling ? basis0 : na, "Basis", color=#2962FF, offset=offset0)
p_up    = plot(OpenBolling ? upper0 : na, "Upper", color=#F23645, offset=offset0)
p_low   = plot(OpenBolling ? lower0 : na, "Lower", color=#089981, offset=offset0)
// Fill (chỉ fill khi bật)
fill(p_up, p_low, title="Background", color= OpenBolling ? Mausac : na)
